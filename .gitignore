# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production builds
dist/
client/dist/

# Environment Variables
.env
server/.env
*.env.local

# Database & Sessions (keep schema & seeds, ignore live sqlite data & sessions)
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
server/data/sessions/
data/

# Uploads
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
