{
  "name": "tamkeen-academy-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js",
    "dev:server": "cd server && node server.js",
    "dev:client": "cd client && npm run dev",
    "test": "cd server && npm run test",
    "migrate": "cd server && npm run migrate",
    "seed": "cd server && npm run seed"
  }
}
